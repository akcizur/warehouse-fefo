/** Warehouse FEFO API — Google Apps Script. Run setupWarehouse() once. */
const SHEETS={materials:'DB_MATERIALS',packs:'DB_PACKS',boxes:'DB_BOXES',locations:'DB_LOCATIONS',movements:'MOVEMENTS'};
const HEADERS={materials:['id','name','unit'],packs:['id','materialId','batch','expiry','boxId','status','initialWeight','receivedAt'],boxes:['id','locationId'],locations:['id','name'],movements:['id','type','entityId','from','to','at','note']};
const PACK_STATUSES=['nový','otevřený','prázdný'];
function setupWarehouse(){const ss=SpreadsheetApp.getActive();Object.keys(SHEETS).forEach(k=>{let sh=ss.getSheetByName(SHEETS[k]);if(!sh)sh=ss.insertSheet(SHEETS[k]);if(sh.getLastRow()===0)sh.appendRow(HEADERS[k]);sh.setFrozenRows(1);});PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());return 'Warehouse sheets ready';}
function doGet(e){try{const action=(e&&e.parameter&&e.parameter.action)||'get';if(action!=='get')throw new Error('Unsupported GET action');return json({ok:true,data:readAll()});}catch(err){return json({ok:false,error:String(err.message||err)});}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(15000);const body=JSON.parse(e.postData.contents||'{}');const action=body.action;if(action==='addPack')addPack(body.pack);else if(action==='movePack')movePack(body.packId,body.boxId,body.fromBoxId);else if(action==='updatePackStatus')updatePackStatus(body.packId,body.status);else if(action==='addMaterial')addMaterial(body.material);else if(action==='addLocation')addLocation(body.location);else if(action==='addBox')addBox(body.box);else throw new Error('Neznámá operace: '+action);return json({ok:true,data:readAll()});}catch(err){return json({ok:false,error:String(err.message||err)});}finally{try{lock.releaseLock()}catch(_){}}}
function saveMasterRecord(k,obj){const existing=findById(k,obj.id);if(existing){const same=HEADERS[k].filter(key=>key!=='id').every(key=>String(existing[key]??'')===String(obj[key]??''));if(same)return;throw new Error('Duplicitní ID: '+obj.id);}append(k,obj)}
function addMaterial(m){if(!m)throw new Error('Chybí surovina');const obj={id:String(m.id||'').trim(),name:String(m.name||'').trim(),unit:String(m.unit||'').trim()};if(!/^MAT-[A-Z]{2}-[0-9]{2}$/.test(obj.id)||!obj.name||!obj.unit)throw new Error('Neplatné údaje suroviny');saveMasterRecord('materials',obj)}
function addLocation(l){if(!l)throw new Error('Chybí pozice');const obj={id:String(l.id||'').trim(),name:String(l.name||'').trim()};if(!/^(REG|PAL)-[A-Z]-[0-9]{2}$/.test(obj.id)||!obj.name)throw new Error('Neplatné údaje pozice');saveMasterRecord('locations',obj)}
function addBox(b){if(!b)throw new Error('Chybí box');const obj={id:String(b.id||'').trim(),locationId:String(b.locationId||'').trim()};if(!/^BOX-[A-Z]-[0-9]{2}$/.test(obj.id)||!exists('locations',obj.locationId))throw new Error('Neplatný box nebo skladová pozice');saveMasterRecord('boxes',obj)}
function addPack(p){if(!p||!p.id||!p.materialId||!p.boxId)throw new Error('Neúplné balení');if(!exists('materials',p.materialId))throw new Error('Surovina nenalezena: '+p.materialId);if(!exists('boxes',p.boxId))throw new Error('Box nenalezen: '+p.boxId);const locationId=getById('boxes',p.boxId,'locationId');if(!exists('locations',locationId))throw new Error('Pozice boxu nenalezena: '+locationId);if(p.expiry&&!/^(0[1-9]|1[0-2])\/[0-9]{2}$/.test(String(p.expiry)))throw new Error('Expirace musí být MM/RR');const status=String(p.status||'nový');if(PACK_STATUSES.indexOf(status)<0)throw new Error('Neplatný stav balení: '+status);const weight=Number(p.initialWeight||0);if(!isFinite(weight)||weight<0)throw new Error('Počáteční hmotnost musí být nezáporné číslo');p.status=status;p.initialWeight=weight;const suppliedReceivedAt=!!p.receivedAt;if(!p.receivedAt)p.receivedAt=new Date().toISOString();const existing=findById('packs',p.id);if(existing){const same=['materialId','batch','expiry','boxId','status','initialWeight'].every(key=>String(existing[key]??'')===String(p[key]??''))&&(!suppliedReceivedAt||String(existing.receivedAt??'')===String(p.receivedAt));if(same)return;throw new Error('Duplicitní ID balení: '+p.id);}append('packs',p);append('movements',{id:movementId(),type:'Příjem',entityId:p.id,from:'',to:p.boxId,at:new Date().toISOString(),note:'Nové balení'});}
function movePack(packId,boxId){if(!exists('packs',packId))throw new Error('Balení nenalezeno: '+packId);if(!exists('boxes',boxId))throw new Error('Cílový box nenalezen: '+boxId);const actualFrom=String(getById('packs',packId,'boxId')||'');if(actualFrom===String(boxId))return;updateById('packs',packId,'boxId',boxId);append('movements',{id:movementId(),type:'Přesun balení',entityId:packId,from:actualFrom,to:boxId,at:new Date().toISOString(),note:'Přesun'});}
function updatePackStatus(packId,status){if(!exists('packs',packId))throw new Error('Balení nenalezeno: '+packId);if(PACK_STATUSES.indexOf(String(status))<0)throw new Error('Neplatný stav balení: '+status);const old=getById('packs',packId,'status');const allowed=old==='nový'?'otevřený':old==='otevřený'?'prázdný':'';if(old===status)return;if(status!==allowed)throw new Error('Nepovolená změna stavu: '+old+' → '+status);updateById('packs',packId,'status',status);append('movements',{id:movementId(),type:'Změna stavu',entityId:packId,from:old,to:status,at:new Date().toISOString(),note:'Stav '+old+' → '+status});}
function readAll(){const out={};Object.keys(SHEETS).forEach(k=>{const sh=sheet(k),values=sh.getDataRange().getValues();out[k]=values.length<2?[]:values.slice(1).filter(r=>r[0]).map(r=>{const o={};HEADERS[k].forEach((h,i)=>{let value=r[i];if(k==='packs'&&h==='expiry'&&value instanceof Date)value=Utilities.formatDate(value,Session.getScriptTimeZone(),'MM/yy');else if(value instanceof Date)value=value.toISOString();o[h]=value;});if(k==='packs')o.initialWeight=Number(o.initialWeight)||0;return o;});if(k==='movements')out[k].reverse();});return out;}
function sheet(k){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Nejdříve spusť setupWarehouse()');const sh=SpreadsheetApp.openById(id).getSheetByName(SHEETS[k]);if(!sh)throw new Error('Chybí list '+SHEETS[k]);return sh;}
function append(k,obj){if(!obj||!obj.id)throw new Error('Chybí ID záznamu');const sh=sheet(k);sh.appendRow(HEADERS[k].map(h=>obj[h]===undefined?'':obj[h]));}
function findById(k,id){const sh=sheet(k),rows=sh.getDataRange().getValues(),idCol=HEADERS[k].indexOf('id');for(let i=1;i<rows.length;i++){if(String(rows[i][idCol])===String(id)){const out={};HEADERS[k].forEach((h,j)=>{let value=rows[i][j];if(k==='packs'&&h==='expiry'&&value instanceof Date)value=Utilities.formatDate(value,Session.getScriptTimeZone(),'MM/yy');else if(value instanceof Date)value=value.toISOString();out[h]=value;});return out;}}return null;}
function getById(k,id,field){const sh=sheet(k),rows=sh.getDataRange().getValues(),idCol=HEADERS[k].indexOf('id'),fieldCol=HEADERS[k].indexOf(field);for(let i=1;i<rows.length;i++)if(String(rows[i][idCol])===String(id))return String(rows[i][fieldCol]??'');throw new Error('Záznam nenalezen: '+id);}
function exists(k,id){const sh=sheet(k),rows=sh.getDataRange().getValues(),idCol=HEADERS[k].indexOf('id');for(let i=1;i<rows.length;i++)if(String(rows[i][idCol])===String(id))return true;return false;}
function updateById(k,id,field,value){const sh=sheet(k),rows=sh.getDataRange().getValues(),idCol=HEADERS[k].indexOf('id'),fieldCol=HEADERS[k].indexOf(field);if(fieldCol<0)throw new Error('Neznámé pole');for(let i=1;i<rows.length;i++){if(String(rows[i][idCol])===String(id)){sh.getRange(i+1,fieldCol+1).setValue(value);return;}}throw new Error('Záznam nenalezen: '+id);}
function movementId(){const rows=sheet('movements').getDataRange().getValues();let max=0;for(let i=1;i<rows.length;i++){const m=String(rows[i][0]||'').match(/^MOV-(\d+)$/);if(m)max=Math.max(max,Number(m[1]));}return 'MOV-'+String(max+1).padStart(6,'0');}
function json(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
