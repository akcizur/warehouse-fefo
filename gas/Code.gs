/** Warehouse FEFO API — Google Apps Script. Run setupWarehouse() once. */
const SHEETS={materials:'DB_MATERIALS',packs:'DB_PACKS',boxes:'DB_BOXES',locations:'DB_LOCATIONS',movements:'MOVEMENTS'};
const HEADERS={materials:['id','name','unit'],packs:['id','materialId','batch','expiry','boxId','status','initialWeight','receivedAt'],boxes:['id','locationId'],locations:['id','name'],movements:['id','type','entityId','from','to','at','note']};
function setupWarehouse(){const ss=SpreadsheetApp.getActive();Object.keys(SHEETS).forEach(k=>{let sh=ss.getSheetByName(SHEETS[k]);if(!sh)sh=ss.insertSheet(SHEETS[k]);if(sh.getLastRow()===0)sh.appendRow(HEADERS[k]);sh.setFrozenRows(1);});PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());return 'Warehouse sheets ready';}
function doGet(e){try{const action=(e&&e.parameter&&e.parameter.action)||'get';if(action!=='get')throw new Error('Unsupported GET action');return json({ok:true,data:readAll()});}catch(err){return json({ok:false,error:String(err.message||err)});}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(15000);const body=JSON.parse(e.postData.contents||'{}');const action=body.action;if(action==='addPack'){append('packs',body.pack);append('movements',{id:'MOV-'+Utilities.getUuid().slice(0,8).toUpperCase(),type:'Příjem',entityId:body.pack.id,from:'',to:body.pack.boxId,at:new Date().toISOString(),note:'Nové balení'});}else if(action==='movePack'){updateById('packs',body.packId,'boxId',body.boxId);append('movements',{id:'MOV-'+Utilities.getUuid().slice(0,8).toUpperCase(),type:'Přesun balení',entityId:body.packId,from:'',to:body.boxId,at:new Date().toISOString(),note:'Přesun'});}else throw new Error('Neznámá operace: '+action);return json({ok:true,data:readAll()});}catch(err){return json({ok:false,error:String(err.message||err)});}finally{try{lock.releaseLock()}catch(_){}}}
function readAll(){const out={};Object.keys(SHEETS).forEach(k=>{const sh=sheet(k),values=sh.getDataRange().getValues();out[k]=values.length<2?[]:values.slice(1).filter(r=>r[0]).map(r=>{const o={};HEADERS[k].forEach((h,i)=>o[h]=r[i] instanceof Date?r[i].toISOString():r[i]);if(k==='packs')o.initialWeight=Number(o.initialWeight)||0;return o;});});return out;}
function sheet(k){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('Nejdříve spusť setupWarehouse()');const sh=SpreadsheetApp.openById(id).getSheetByName(SHEETS[k]);if(!sh)throw new Error('Chybí list '+SHEETS[k]);return sh;}
function append(k,obj){if(!obj||!obj.id)throw new Error('Chybí ID záznamu');const sh=sheet(k);sh.appendRow(HEADERS[k].map(h=>obj[h]===undefined?'':obj[h]));}
function updateById(k,id,field,value){const sh=sheet(k),rows=sh.getDataRange().getValues(),idCol=HEADERS[k].indexOf('id'),fieldCol=HEADERS[k].indexOf(field);if(fieldCol<0)throw new Error('Neznámé pole');for(let i=1;i<rows.length;i++){if(String(rows[i][idCol])===String(id)){sh.getRange(i+1,fieldCol+1).setValue(value);return;}}throw new Error('Záznam nenalezen: '+id);}
function json(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
